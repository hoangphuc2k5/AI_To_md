{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "includeFiles": "gateway/index.html",
      "excludeFiles": "{MinerU/**,data/**,**/.venv*/**,**/.pytest_cache/**,**/__pycache__/**,**/tests/**}"
    }
  }
}
