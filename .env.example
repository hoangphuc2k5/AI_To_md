# Gateway
API_BIND_HOST=127.0.0.1
API_PORT=8080
MINERU_HOST=127.0.0.1
MINERU_PORT=8000
# For Vercel preview/production, use the public HTTPS MinerU service URL (without /v1).
MINERU_API_URL=http://127.0.0.1:8000
MAX_FILE_SIZE_MB=50
MAX_CONCURRENT_REQUESTS=1
REQUEST_TIMEOUT_SECONDS=60
PROCESSING_TIMEOUT_SECONDS=1800
POLL_INTERVAL_SECONDS=1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TEMP_DIR=./data/gateway-tmp
MINERU_UPLOAD_DIR=./data/mineru-uploads
OUTPUT_DIR=./data/output

# MinerU service. Standard enables the OCR/vision tiers; model files are cached in a named volume.
MINERU_TIER=standard
MINERU_CONCURRENCY=1
MINERU_PRELOAD_MODELS=true
MINERU_STARTUP_TIMEOUT_SECONDS=900
MINERU_MODEL_SOURCE=local
MINERU_LOG_LEVEL=warning
MINERU_API_KEY=